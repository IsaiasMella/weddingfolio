---
/**
 * Navegación "Previous / Next" de los listados paginados (/portfolio, /blog).
 *
 * NO existe en el original: allí todo el contenido entra en una sola página.
 * Acá los listados usan `paginate()`, así que si se agregan más de PAGE_SIZE
 * elementos aparecen /blog/2/, /blog/3/… y este componente. Con una sola
 * página no se renderiza nada y el HTML queda idéntico al original.
 *
 * Usa los mismos botones "ghost" del sitio. Los extremos sin destino se
 * omiten (en vez de un botón deshabilitado) y un espaciador vacío mantiene
 * "Next" alineado a la derecha.
 */
import Button from '@/components/ui/Button.astro';

type Props = {
  currentPage: number;
  lastPage: number;
  prevUrl: string | undefined;
  nextUrl: string | undefined;
  /** Nombre accesible del <nav> (ej. "Journal pages"). */
  label: string;
};

const { currentPage, lastPage, prevUrl, nextUrl, label } = Astro.props;
---

{
  lastPage > 1 && (
    <nav class="mt-16 flex items-center justify-between gap-4 border-t border-ivory/10 pt-8" aria-label={label}>
      {prevUrl ? (
        <Button href={prevUrl} variant="ghost" rel="prev">
          <span aria-hidden="true">←</span> Previous
        </Button>
      ) : (
        <span />
      )}
      <p class="text-xs uppercase tracking-meta text-stone">
        Page {currentPage} of {lastPage}
      </p>
      {nextUrl ? (
        <Button href={nextUrl} variant="ghost" rel="next">
          Next <span aria-hidden="true">→</span>
        </Button>
      ) : (
        <span />
      )}
    </nav>
  )
}
