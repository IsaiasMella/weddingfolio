---
/**
 * Foto de portada de un artículo, entre la cabecera y el texto. Formato
 * panorámico (21:9 en celular, 2:1 desde `sm`) con un alto máximo para que
 * no empuje el texto fuera de la pantalla en monitores anchos.
 * Es la imagen principal del primer pantallazo (LCP): va con `priority`.
 */
import Container from '@/components/ui/Container.astro';
import Photo from '@/components/ui/Photo.astro';

type Props = {
  src: string;
  alt: string;
};

const { src, alt } = Astro.props;
---

<div class="pb-10">
  <Container>
    <div class="overflow-hidden aspect-cinema max-h-112 bg-ink-muted sm:aspect-banner">
      <Photo
        src={src}
        alt={alt}
        width={1600}
        height={900}
        sizes="(max-width: 1280px) 100vw, 1280px"
        priority
        class="h-full w-full object-cover"
      />
    </div>
  </Container>
</div>
