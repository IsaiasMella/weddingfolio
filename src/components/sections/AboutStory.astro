---
/**
 * Cuerpo de /about: retrato grande de Elena (7 columnas) junto a su historia
 * (5 columnas), el botón de disponibilidad y las cifras debajo.
 *
 * El retrato es la imagen principal de la página (LCP) → `priority`.
 * Su proporción cambia por ancho: 4:5 en celular, 16:11 en tablet (para que
 * no ocupe toda la pantalla) y otra vez 4:5 en escritorio.
 */
import { PRIMARY_CTA } from '@/data/site';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Photo from '@/components/ui/Photo.astro';
import Stats from '@/components/sections/Stats.astro';
import { ABOUT } from '@/data/about';

/** Párrafos de la historia; el primero es el mismo texto de la home. */
const PARAGRAPHS = [
  ABOUT.approach,
  'You will leave with images that feel editorial yet deeply personal — the kind you hang, print, and pass down.',
  'When I am not photographing weddings, you will find me chasing fog along the coast, printing darkroom tests, or planning the next destination season with a very large coffee.',
];
---

<section class="pb-20 sm:pb-28">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-7">
        <div class="aspect-portrait overflow-hidden bg-ink-muted sm:aspect-feature lg:aspect-portrait">
          <Photo
            src={ABOUT.portraitLarge}
            alt="Elena Moreau at work photographing a wedding"
            width={1400}
            height={1750}
            sizes="(max-width: 1024px) 100vw, 58vw"
            priority
            class="h-full w-full object-cover"
          />
        </div>
      </div>
      <div class="reveal reveal-delay-2 flex flex-col justify-center lg:col-span-5">
        {
          PARAGRAPHS.map((text, i) => (
            <p
              class:list={[
                'text-base leading-relaxed text-stone-light sm:text-lg',
                i === PARAGRAPHS.length - 1 ? 'mb-8' : 'mb-5',
              ]}
            >
              {text}
            </p>
          ))
        }
        <Button href={PRIMARY_CTA.href}>{PRIMARY_CTA.label}</Button>
      </div>
    </div>
    <Stats />
  </Container>
</section>
