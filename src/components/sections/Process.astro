---
/**
 * "How it works": los pasos de src/content/process.yaml numerados 01, 02…
 * El número sale del campo `order`, así que agregar un paso no obliga a
 * renumerar a mano. Se usa en la home y en /services.
 */
import { getOrdered, revealDelay } from '@/lib/content';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const steps = await getOrdered('process');
---

<section class="py-20 sm:py-28" aria-labelledby="process-heading">
  <Container>
    <SectionHeading
      eyebrow="How it works"
      title="A calm path from first hello to final gallery."
      lead="No pressure tactics — just a clear process designed around your timeline."
      id="process-heading"
      class="mb-14 sm:mb-16"
    />
    <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        steps.map((step, i) => (
          <li class:list={['reveal', revealDelay(i)]}>
            <p class="font-display text-4xl text-champagne/80">{String(step.data.order).padStart(2, '0')}</p>
            <h3 class="mt-4 font-display text-2xl text-ivory">{step.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-stone-light">{step.data.description}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
