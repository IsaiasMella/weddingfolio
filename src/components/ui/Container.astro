---
/**
 * Contenedor centrado con los márgenes laterales del sitio (20 px en celular,
 * 32 px desde `sm`). `size` elige el ancho máximo: 7xl (80rem) para secciones
 * y grillas, 3xl (48rem) para texto de lectura.
 */
type Props = {
  size?: '7xl' | '3xl';
  class?: string;
};

const { size = '7xl', class: className } = Astro.props;
---

<div class:list={['mx-auto w-full px-5 sm:px-8', size === '7xl' ? 'max-w-7xl' : 'max-w-3xl', className]}>
  <slot />
</div>
