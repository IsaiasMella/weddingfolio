---
/**
 * /about: presentación de Elena. Cabecera (PageIntro con título más grande),
 * retrato + historia + cifras, y el CTA final con un texto propio.
 * La imagen social es el retrato (como en el original).
 */
import { SITE } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/ui/PageIntro.astro';
import AboutStory from '@/components/sections/AboutStory.astro';
import CtaBanner from '@/components/shared/CtaBanner.astro';
import { ABOUT } from '@/data/about';
---

<BaseLayout
  title="About"
  description={`Meet Elena Moreau — the photographer behind ${SITE.name} Editorial wedding photography rooted in calm presence and honest light.`}
  image={ABOUT.portrait}
>
  <PageIntro
    eyebrow="About"
    title={ABOUT.title}
    lead={ABOUT.intro}
    class="pb-16 sm:pb-20"
    titleClass="leading-tight md:text-7xl"
    leadClass="mt-6 max-w-2xl text-lg sm:text-xl"
  />
  <AboutStory />
  <CtaBanner
    title="Let’s see if we are a fit."
    text="A short conversation tells us more than a hundred emails. Share your date and we will take it from there."
  />
</BaseLayout>
