---
/**
 * /contact: datos de contacto a la izquierda (5 columnas) y formulario a la
 * derecha (7 columnas). No lleva CTA final: la página entera es el CTA.
 */
import { SITE } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import ContactInfo from '@/components/contact/ContactInfo.astro';
import ContactForm from '@/components/contact/ContactForm.astro';
---

<BaseLayout
  title="Contact"
  description={`Inquire about wedding photography with ${SITE.name} Share your date, venue, and vision — we reply within two business days.`}
>
  <section class="pt-32 pb-20 sm:pt-40 sm:pb-28">
    <Container>
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
        <div class="reveal lg:col-span-5">
          <ContactInfo />
        </div>
        <div class="reveal reveal-delay-2 lg:col-span-7">
          <ContactForm />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
